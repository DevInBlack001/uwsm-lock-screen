#!/usr/bin/env bash
set -uo pipefail

# readlink -f resolves the symlink install.sh creates in ~/.local/bin/ to
# this script's real location, so ../lib/ finds the actual library dir
# instead of a nonexistent one next to the symlink.
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/../lib/wallpaper-pool.sh"
source "$SCRIPT_DIR/../lib/wallpaper-fetch.sh"

theme="$(wp_theme_name)"
if [[ -z "$theme" ]]; then
  gum style --foreground 1 "No active Omarchy theme detected."
  exit 1
fi

sources_file="$(wp_sources_file "$theme")"
mkdir -p "$(dirname "$sources_file")"
touch "$sources_file"

CLONE_MIRROR_DIR="$SCRIPT_DIR/../../clone-mirror"
LAYOUT_PRESETS_JS="$CLONE_MIRROR_DIR/LayoutPresets.js"
STYLE_PRESETS_JS="$CLONE_MIRROR_DIR/StylePresets.js"
current_wallpaper_link="$HOME/.local/state/uwsm-lock-screen/current-wallpaper"

have_chafa=0
command -v chafa >/dev/null 2>&1 && have_chafa=1
THUMB_W=22
THUMB_H=9

# Whether chafa's own terminal auto-detection picked a pixel-graphics
# protocol (kitty/iterm/sixel - a single escape-sequence "blob" anchored at
# the cursor) or plain character art ("text" - normal multi-line output).
# Env-var checks like KITTY_WINDOW_ID are unreliable (unset in some launch
# contexts even under a kitty-capable terminal), so this asks chafa itself
# by rendering one real probe image and inspecting the escape bytes it
# actually emitted. Decided once per run and cached.
chafa_mode=""
detect_chafa_mode() {
  [[ -n "$chafa_mode" ]] && return
  chafa_mode="text"
  local probe_path="$1"
  [[ $have_chafa -eq 1 && -n "$probe_path" && -r "$probe_path" ]] || return
  local probe
  probe="$(chafa -s 4x2 -- "$probe_path" 2>/dev/null)"
  if [[ "$probe" == *$'\033_G'* || "$probe" == *$'\033Pq'* ]]; then
    chafa_mode="blob"
  fi
}

# Renders a row of thumbnails side by side (not stacked), as many as fit the
# terminal width, instead of one huge column that wastes all the horizontal
# space. Missing/unreadable images or a missing chafa just leave that cell
# blank - captions are printed underneath regardless.
render_thumbnail_grid() {
  local -a paths=("$@")
  [[ ${#paths[@]} -gt 0 ]] || return 0
  detect_chafa_mode "${paths[0]}"
  local term_w per_row
  term_w="$(tput cols 2>/dev/null || echo 80)"
  per_row=$(( term_w / (THUMB_W + 2) ))
  [[ $per_row -ge 1 ]] || per_row=1

  local i=0
  while [[ $i -lt ${#paths[@]} ]]; do
    local -a row=("${paths[@]:$i:$per_row}")
    local c p caprow

    if [[ "$chafa_mode" == "blob" ]]; then
      # A pixel-graphics protocol anchors each image at the cursor's
      # current cell as one opaque escape blob, not composable text lines -
      # so instead of joining captured output as strings (which breaks into
      # overlapping smears), save the row's start position once and
      # explicitly move to each column before drawing, restoring between
      # images so every draw starts from the same anchor regardless of
      # where the previous image left the cursor. No -f override: this
      # reuses whichever protocol chafa itself already detected works here.
      printf '\033[s'
      c=0
      for p in "${row[@]}"; do
        printf '\033[u'
        [[ $c -gt 0 ]] && printf '\033[%dC' "$((c * (THUMB_W + 2)))"
        [[ -r "$p" ]] && chafa -s "${THUMB_W}x${THUMB_H}" -- "$p" 2>/dev/null
        c=$((c + 1))
      done
      printf '\033[u'
      printf '\033[%dB' "$THUMB_H"
    else
      local -A cell=()
      local max_lines=0 out line lc rowline
      c=0
      for p in "${row[@]}"; do
        out=""
        if [[ $have_chafa -eq 1 && -r "$p" ]]; then
          out="$(chafa -f symbols -s "${THUMB_W}x${THUMB_H}" -- "$p" 2>/dev/null)"
        fi
        lc=0
        while IFS= read -r line; do
          cell["$c,$lc"]="$line"
          lc=$((lc + 1))
        done <<< "$out"
        [[ $lc -gt $max_lines ]] && max_lines=$lc
        c=$((c + 1))
      done
      local l=0
      while [[ $l -lt $max_lines ]]; do
        rowline=""
        c=0
        while [[ $c -lt ${#row[@]} ]]; do
          rowline+="${cell[$c,$l]:-}  "
          c=$((c + 1))
        done
        printf '%s\n' "$rowline"
        l=$((l + 1))
      done
    fi

    caprow=""
    for p in "${row[@]}"; do
      caprow+="$(printf '%-*s' "$((THUMB_W + 2))" "$(basename "$p")")"
    done
    gum style --foreground 245 "$caprow"
    echo

    i=$((i + per_row))
  done
}

# Lists the active theme's own built-in wallpapers (read-only - these
# aren't in sources_file and can't be removed via remove_source, only
# toggled on/off as a whole via "Toggle rotation").
list_theme_backgrounds() {
  local bg_dir
  bg_dir="$(wp_theme_backgrounds_dir)"
  [[ -d "$bg_dir" ]] || return 0
  find "$bg_dir" -maxdepth 1 -type f 2>/dev/null | sort
}

list_entries() {
  # Prints "<physical line number>. <entry> [(status)]" - the line number
  # tracks every line in the file (including blanks/comments we skip over),
  # not a count of only the displayed entries, so it can be fed straight
  # into `sed -Nd` later without off-by-N errors from skipped lines.
  local i=0
  while IFS= read -r line; do
    i=$((i + 1))
    [[ -n "$line" && "$line" != \#* ]] || continue
    if wp_is_url "$line"; then
      local ext cache_path
      ext="${line##*.}"
      [[ "$ext" =~ ^[A-Za-z0-9]{1,5}$ ]] || ext="jpg"
      cache_path="$(wp_cache_path_for_url "$theme" "$line" "$ext")"
      if [[ -s "$cache_path" ]]; then
        echo "$i. $line (cached)"
      else
        echo "$i. $line (not cached)"
      fi
    else
      echo "$i. $line"
    fi
  done < "$sources_file"
}

add_source() {
  local entry
  entry="$(gum input --placeholder "Local path or https:// URL")"
  [[ -n "$entry" ]] || return

  if wp_is_url "$entry"; then
    local ext="${entry##*.}"
    [[ "$ext" =~ ^[A-Za-z0-9]{1,5}$ ]] || ext="jpg"
    local cache_path
    cache_path="$(wp_cache_path_for_url "$theme" "$entry" "$ext")"
    mkdir -p "$(wp_cache_dir "$theme")"
    if wp_fetch_url "$entry" "$cache_path"; then
      echo "$entry" >> "$sources_file"
      gum style --foreground 2 "Added and cached: $entry"
    else
      gum style --foreground 1 "Could not download or validate: $entry"
    fi
    return
  fi

  if wp_is_safe_local_path "$entry"; then
    echo "$entry" >> "$sources_file"
    gum style --foreground 2 "Added: $entry"
  else
    gum style --foreground 1 "Path must be absolute, exist, and not be a symlink: $entry"
  fi
}

remove_source() {
  local current
  current="$(list_entries)"
  [[ -n "$current" ]] || { gum style --foreground 3 "No sources to remove."; return; }

  local picked
  picked="$(printf '%s\n' "$current" | gum choose --header "Remove which source?")"
  [[ -n "$picked" ]] || return

  local line_no="${picked%%.*}"
  sed -i "${line_no}d" "$sources_file"
  gum style --foreground 2 "Removed entry $line_no."
}

toggle_rotation() {
  local marker
  marker="$(wp_disabled_marker "$theme")"
  if wp_rotation_enabled "$theme"; then
    touch "$marker"
    gum style --foreground 3 "Rotation disabled for $theme."
  else
    rm -f "$marker"
    gum style --foreground 2 "Rotation enabled for $theme."
  fi
}

# Sets a specific wallpaper right now, bypassing random rotation, by writing
# straight to the same symlink target uwsm-lock-wallpaper-rotate uses -
# the next lock shows exactly this image regardless of rotation setting.
set_wallpaper_now() {
  local path="$1"
  # Re-validate at use time, not just at add time: a source that was a safe
  # real file when added could have been swapped for a symlink to an
  # arbitrary file since, and this must not follow it into the lock screen.
  wp_is_safe_local_path "$path" || { gum style --foreground 1 "Not a safe local file: $path"; return; }
  mkdir -p "$(dirname "$current_wallpaper_link")"
  ln -sfn "$path" "$current_wallpaper_link"
  gum style --foreground 2 "Lock screen will use: $(basename "$path")"
}

pick_wallpaper_now() {
  local bg_files entries choices picked path
  bg_files="$(list_theme_backgrounds)"
  entries="$(list_entries)"
  choices=()
  [[ -n "$bg_files" ]] && while IFS= read -r f; do choices+=("$f"); done <<< "$bg_files"
  if [[ -n "$entries" ]]; then
    while IFS= read -r entry_line; do
      path="$(printf '%s' "$entry_line" | sed -E 's/^[0-9]+\. ([^ ]+).*/\1/')"
      wp_is_url "$path" || choices+=("$path")
    done <<< "$entries"
  fi
  [[ ${#choices[@]} -gt 0 ]] || { gum style --foreground 3 "No local wallpapers available to pick yet."; return; }
  picked="$(printf '%s\n' "${choices[@]}" | gum choose --header "Set which wallpaper now?")"
  [[ -n "$picked" ]] || return
  set_wallpaper_now "$picked"
}

select_layout() {
  local names name line picked
  names="$(wp_preset_names_from_js "$LAYOUT_PRESETS_JS")"
  [[ -n "$names" ]] || { gum style --foreground 1 "Could not read layout presets."; return; }
  local -a lines=()
  while IFS= read -r name; do
    lines+=("$(printf '%-22s %s' "$name" "$(wp_layout_preview "$LAYOUT_PRESETS_JS" "$name")")")
  done <<< "$names"
  line="$(printf '%s\n' "${lines[@]}" | gum choose --header "Select layout (name + preview)")"
  [[ -n "$line" ]] || return
  picked="${line%% *}"
  wp_write_appearance "$picked" ""
  gum style --foreground 2 "Layout set to: $picked"
}

select_style() {
  local names name line picked
  names="$(wp_preset_names_from_js "$STYLE_PRESETS_JS")"
  [[ -n "$names" ]] || { gum style --foreground 1 "Could not read style presets."; return; }
  local -a lines=()
  while IFS= read -r name; do
    lines+=("$(printf '%-18s %s' "$name" "$(wp_style_preview "$STYLE_PRESETS_JS" "$name")")")
  done <<< "$names"
  line="$(printf '%s\n' "${lines[@]}" | gum choose --header "Select style (name + preview)")"
  [[ -n "$line" ]] || return
  picked="${line%% *}"
  wp_write_appearance "" "$picked"
  gum style --foreground 2 "Style set to: $picked"
}

# Signature of everything the gallery render depends on: changes only when
# a source is added/removed or the theme's background files change, not on
# every pass through the menu loop. gallery_cache/gallery_cache_sig persist
# across iterations, so going back from an action (e.g. after picking a
# layout) redraws instantly from the cached render instead of re-running
# chafa on every thumbnail again.
gallery_sig() {
  local bg_dir
  bg_dir="$(wp_theme_backgrounds_dir)"
  printf '%s|%s' \
    "$(stat -c '%Y %s' "$sources_file" 2>/dev/null)" \
    "$(find "$bg_dir" -maxdepth 1 -type f -printf '%f %Y|' 2>/dev/null)"
}

# Builds the gallery view: sorted thumbnail grids with captions underneath
# each image (photo-app style), not a mixed image+raw-text-listing dump.
# Theme backgrounds are already filesystem-sorted by list_theme_backgrounds;
# local sources are sorted by filename here so the grid order stays stable
# and predictable across redraws instead of following insertion order.
build_gallery() {
  local bg_files entries entry_line entry_path cap out
  local -a bg_paths=() local_paths=() url_captions=()

  out=""
  bg_files="$(list_theme_backgrounds)"
  if [[ -n "$bg_files" ]]; then
    while IFS= read -r f; do bg_paths+=("$f"); done <<< "$bg_files"
    out+="$(gum style --foreground 212 --bold "Theme backgrounds (${#bg_paths[@]})")"$'\n\n'
    out+="$(render_thumbnail_grid "${bg_paths[@]}")"$'\n'
  fi

  entries="$(list_entries)"
  if [[ -n "$entries" ]]; then
    while IFS= read -r entry_line; do
      entry_path="$(printf '%s' "$entry_line" | sed -E 's/^[0-9]+\. ([^ ]+).*/\1/')"
      if wp_is_url "$entry_path"; then
        url_captions+=("${entry_line#*. }")
      else
        local_paths+=("$entry_path")
      fi
    done <<< "$entries"
  fi
  [[ ${#local_paths[@]} -gt 0 ]] && mapfile -t local_paths < <(printf '%s\n' "${local_paths[@]}" | awk -F/ '{print $NF, $0}' | sort | cut -d' ' -f2-)

  out+="$(gum style --foreground 212 --bold "Your sources (${#local_paths[@]} local, ${#url_captions[@]} online)")"$'\n\n'
  if [[ ${#local_paths[@]} -gt 0 ]]; then
    out+="$(render_thumbnail_grid "${local_paths[@]}")"$'\n'
  fi
  if [[ ${#url_captions[@]} -gt 0 ]]; then
    out+="$(gum style --foreground 3 "  Online (no thumbnail until cached):")"$'\n'
    for cap in "${url_captions[@]}"; do
      out+="$(gum style --foreground 245 "    $cap")"$'\n'
    done
  fi
  if [[ ${#local_paths[@]} -eq 0 && ${#url_captions[@]} -eq 0 ]]; then
    out+="$(gum style --foreground 3 "  (none added yet)")"$'\n'
  fi

  printf '%s' "$out"
}

gallery_cache=""
gallery_cache_sig=""

while true; do
  # Redraw in place instead of appending another full copy below the last
  # one every time the loop comes back around after an action.
  tput clear 2>/dev/null || clear 2>/dev/null || true

  status="disabled"
  wp_rotation_enabled "$theme" && status="enabled"
  cur_layout="$(wp_read_appearance layout)"; [[ -n "$cur_layout" ]] || cur_layout="(default)"
  cur_style="$(wp_read_appearance style)"; [[ -n "$cur_style" ]] || cur_style="(default)"
  gum style --border rounded --border-foreground 212 --padding "1 2" --margin "1 0" --bold --width 76 \
    "Lock Screen Wallpapers" \
    "Theme: $theme    Rotation: $status" \
    "Layout: $cur_layout    Style: $cur_style"

  current_sig="$(gallery_sig)"
  if [[ "$current_sig" != "$gallery_cache_sig" ]]; then
    gallery_cache="$(build_gallery)"
    gallery_cache_sig="$current_sig"
  fi
  printf '%s\n' "$gallery_cache"

  action="$(gum choose "Set wallpaper now" "Add source" "Remove source" "Toggle rotation" "Select layout" "Select style" "Quit" --header "Action")"
  case "$action" in
    "Set wallpaper now") pick_wallpaper_now ;;
    "Add source") add_source ;;
    "Remove source") remove_source ;;
    "Toggle rotation") toggle_rotation ;;
    "Select layout") select_layout ;;
    "Select style") select_style ;;
    "Quit"|"") break ;;
  esac
  # The action just printed a result message above - give it a moment on
  # screen before the top of the loop clears and redraws, instead of
  # wiping it out instantly.
  read -rsn1 -t 2 _ || true
done
